{
  "id": "card_grid",
  "type": "SharedSlice",
  "name": "CardGrid",
  "description": "Two or three column cards with optional images and links",
  "variations": [
    {
      "id": "default",
      "name": "Default",
      "version": "initial",
      "description": "Two or three column cards with optional images and links",
      "imageUrl": "",
      "primary": {
        "heading": {
          "type": "StructuredText",
          "config": {
            "label": "Section heading",
            "single": "heading1,heading2"
          }
        },
        "intro": {
          "type": "StructuredText",
          "config": {
            "label": "Introduction",
            "multi": "paragraph,heading2,heading3,strong,em,hyperlink,list-item,o-list-item"
          }
        },
        "columns": {
          "type": "Select",
          "config": {
            "label": "Columns",
            "options": [
              "two",
              "three"
            ]
          }
        },
        "background": {
          "type": "Select",
          "config": {
            "label": "Background",
            "options": [
              "paper",
              "sunk"
            ]
          }
        },
        "entries": {
          "type": "Group",
          "config": {
            "label": "Entries",
            "repeat": true,
            "fields": {
              "title": {
                "type": "Text",
                "config": {
                  "label": "Card heading"
                }
              },
              "body": {
                "type": "StructuredText",
                "config": {
                  "label": "Card body",
                  "multi": "paragraph,heading2,heading3,strong,em,hyperlink,list-item,o-list-item"
                }
              },
              "image": {
                "type": "Image",
                "config": {
                  "label": "Card image",
                  "constraint": {},
                  "thumbnails": []
                }
              },
              "label": {
                "type": "Text",
                "config": {
                  "label": "Image label"
                }
              },
              "button_label": {
                "type": "Text",
                "config": {
                  "label": "Button label"
                }
              },
              "button_link": {
                "type": "Link",
                "config": {
                  "label": "Button destination"
                }
              }
            }
          }
        }
      },
      "items": {}
    }
  ]
}
