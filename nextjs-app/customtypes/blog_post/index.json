{
  "id": "blog_post",
  "label": "Blog Post",
  "repeatable": true,
  "status": true,
  "json": {
    "Main": {
      "uid": {
        "type": "UID",
        "config": {
          "label": "URL slug"
        }
      },
      "title": {
        "type": "StructuredText",
        "config": {
          "label": "Title",
          "single": "heading1"
        }
      },
      "excerpt": {
        "type": "StructuredText",
        "config": {
          "label": "Excerpt",
          "single": "paragraph"
        }
      },
      "category": {
        "type": "Text",
        "config": {
          "label": "Category"
        }
      },
      "category_filter": {
        "type": "Select",
        "config": {
          "label": "Category filter",
          "options": [
            "energy",
            "wash",
            "climate",
            "agriculture"
          ]
        }
      },
      "date": {
        "type": "Date",
        "config": {
          "label": "Publish date"
        }
      },
      "read_time": {
        "type": "Text",
        "config": {
          "label": "Read time",
          "placeholder": "e.g. 8 min read"
        }
      },
      "author_name": {
        "type": "Text",
        "config": {
          "label": "Author name"
        }
      },
      "author_role": {
        "type": "Text",
        "config": {
          "label": "Author role"
        }
      },
      "featured": {
        "type": "Boolean",
        "config": {
          "label": "Featured on /news",
          "default_value": false
        }
      },
      "hero_image": {
        "type": "Image",
        "config": {
          "label": "Hero / lead image"
        }
      },
      "key_takeaways": {
        "type": "Group",
        "config": {
          "label": "Key Takeaways",
          "fields": {
            "text": {
              "type": "Text",
              "config": {
                "label": "Takeaway"
              }
            }
          }
        }
      },
      "sidebar_stats": {
        "type": "Group",
        "config": {
          "label": "Sidebar stat cards",
          "fields": {
            "title": {
              "type": "Text",
              "config": {
                "label": "Stat title"
              }
            },
            "value": {
              "type": "Text",
              "config": {
                "label": "Stat value"
              }
            },
            "body": {
              "type": "Text",
              "config": {
                "label": "Stat description"
              }
            }
          }
        }
      },
      "body": {
        "type": "StructuredText",
        "config": {
          "label": "Body",
          "multi": "paragraph,heading1,heading2,heading3,heading4,heading5,heading6,strong,em,hyperlink,image,list-item,o-list-item,preformatted"
        }
      },
      "references": {
        "type": "Group",
        "config": {
          "label": "References",
          "fields": {
            "text": {
              "type": "Text",
              "config": {
                "label": "Citation text"
              }
            },
            "url": {
              "type": "Link",
              "config": {
                "label": "Source URL"
              }
            }
          }
        }
      },
      "lead_image_label": {
        "type": "Text",
        "config": {
          "label": "Lead image label"
        }
      }
    }
  }
}
