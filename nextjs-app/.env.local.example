# Name of your Prismic repository (the subdomain in https://<name>.prismic.io).
# Leave unset to run on the mock content in lib/mock-content.ts.
NEXT_PUBLIC_PRISMIC_ENVIRONMENT=

# Optional for repositories with private content.
PRISMIC_ACCESS_TOKEN=

# Set this same secret on the Prismic publication webhook.
PRISMIC_WEBHOOK_SECRET=
